# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bybit
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_PROXY_URL=your_supabase_bybit_proxy_url_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Server
PORT=3000
NODE_ENV=development

# Timezone
TIMEZONE=Asia/Seoul

# Paper Signal Lab (alert-only, no live Bybit orders)
PAPER_SIGNAL_TRACKING_ENABLED=false
PAPER_SIGNAL_AUTO_LOG_ENABLED=false
PAPER_SIGNAL_ALERTS_ENABLED=true
PAPER_SIGNAL_TTL_MINUTES=90
PAPER_SIGNAL_TRACK_INTERVAL_MS=60000
PAPER_SIGNAL_EXPERIMENT_ID=SCALPARENA_V2_20260719
CANDIDATE_V3_EXPERIMENT_ID=CANDIDATE_V3_20260720
PUMP_V2_EXPERIMENT_ID=PUMP_V2_ATR13_20260725
PAPER_SIGNAL_SLIPPAGE_BPS=5
MARKET_CONTEXT_V1_ENABLED=true

# Candidate research cycle (V3 diagnostics/paper; no live Bybit orders)
CANDIDATE_AUTO_SCAN_ENABLED=false
CANDIDATE_V1_ALERTS_ENABLED=false
CANDIDATE_AUTO_SCAN_INTERVAL_MS=600000
CANDIDATE_AUTO_MIN_SCORE=75
CANDIDATE_AUTO_MIN_RR=1.2
CANDIDATE_AUTO_COOLDOWN_MINUTES=90
CANDIDATE_AUTO_MAX_ALERTS=2
CANDIDATE_V3_ENABLED=true
CANDIDATE_V3_MAX_PER_CYCLE=1

# PumpHunter Lab (manual paper-only pump continuation scanner)
PUMP_HUNTER_SCAN_LIMIT=40
PUMP_HUNTER_KLINE_INTERVAL=15
PUMP_HUNTER_KLINE_LIMIT=96
PUMP_HUNTER_ACTIONABLE_LIMIT=3
PUMP_HUNTER_USE_TESTNET=false
PUMP_HUNTER_REST_BASES=api.bybit.com,api.bytick.com,api.bytick.nl,api.bybit-tr.com,api.bybit.kz
PUMP_V2_SHADOW_ENABLED=true
PUMP_V2_SHADOW_MAX_PER_CYCLE=2

# Extreme Radar wide diagnostics (research-only, no events/signals/alerts)
EXTREME_WIDE_SCAN_ENABLED=false
EXTREME_WIDE_SCAN_INTERVAL_MS=180000
EXTREME_WIDE_MIN_TURNOVER_USD=5000000
EXTREME_WIDE_ANOMALY_SCORE=45
EXTREME_WIDE_EXAMPLE_LIMIT=10
