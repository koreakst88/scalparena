# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bybit
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_PROXY_URL=your_supabase_bybit_proxy_url_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Server
PORT=3000
NODE_ENV=development

# Timezone
TIMEZONE=Asia/Seoul

# Paper Signal Lab (alert-only, no live Bybit orders)
PAPER_SIGNAL_TRACKING_ENABLED=false
PAPER_SIGNAL_AUTO_LOG_ENABLED=false
PAPER_SIGNAL_ALERTS_ENABLED=true
PAPER_SIGNAL_TTL_MINUTES=90
PAPER_SIGNAL_TRACK_INTERVAL_MS=60000

# Candidate Auto Scan (alert-only, no live Bybit orders)
CANDIDATE_AUTO_SCAN_ENABLED=false
CANDIDATE_AUTO_SCAN_INTERVAL_MS=600000
CANDIDATE_AUTO_MIN_SCORE=75
CANDIDATE_AUTO_MIN_RR=1.2
CANDIDATE_AUTO_COOLDOWN_MINUTES=90
CANDIDATE_AUTO_MAX_ALERTS=2

# PumpHunter Lab (manual paper-only pump continuation scanner)
PUMP_HUNTER_SCAN_LIMIT=40
PUMP_HUNTER_KLINE_INTERVAL=15
PUMP_HUNTER_KLINE_LIMIT=96
PUMP_HUNTER_ACTIONABLE_LIMIT=3
PUMP_HUNTER_USE_TESTNET=false
PUMP_HUNTER_REST_BASES=api.bybit.com,api.bytick.com
